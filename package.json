{
  "name": "@wyre-ai/node-connectwise-automate",
  "version": "4.0.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Comprehensive, fully-typed Node.js/TypeScript library for the ConnectWise Automate API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "connectwise",
    "connectwise-automate",
    "automate",
    "labtech",
    "rmm",
    "msp",
    "api",
    "typescript",
    "remote-monitoring"
  ],
  "author": "Aaron Sachs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYRE-AI/node-connectwise-automate.git"
  },
  "bugs": {
    "url": "https://github.com/WYRE-AI/node-connectwise-automate/issues"
  },
  "homepage": "https://github.com/WYRE-AI/node-connectwise-automate#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "msw": "^3.0.2",
    "semantic-release": "^25.0.9",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "undici": "^7.30.0"
  }
}
